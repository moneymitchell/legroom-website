---
import Underline from "./ui/Underline.astro";
import { site } from "@/content/site";

/**
 * Credibility. 669px tall at 1440, on Manila, continuing the band the
 * Breakdown opened.
 *
 * R2 changes: the three one-word chips became three real selling points as a
 * bordered list, pushed to the bottom of the left column so its last rule lines
 * up with the bottom of the client table. The sentence under the table is gone
 * and the table grew into the space. Each client result now centres vertically
 * in its box: mark at the top, result in the middle, company at the bottom.
 *
 * THE GHOST WIDTHS ARE PER-LOGO (140/172/126/134%). The four source files
 * differ in aspect ratio by about 5x, so one shared value makes GradMasters
 * unreadable and EL1 invisible. The numbers come from site.ts, re-measured for
 * R2. Do not normalise them.
 */
const { credibility } = site;
---

<section class="band" aria-labelledby="cred-title">
  <div class="wrap">
    <div class="cg">
      <div class="col">
        <p class="eyebrow">{credibility.eyebrow}</p>
        <h2 id="cred-title">
          {credibility.headlineBefore}<br />
          {credibility.headlineLead}<Underline>{credibility.headlineUnderline}</Underline
          >{credibility.headlineTail}
        </h2>
        <p class="body">{credibility.body}</p>

        <ul class="sell">
          {
            credibility.selling.map((s) => (
              <li>
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                  <path
                    d="M1.5 7 L5 10.5 L11.5 2.5"
                    stroke="#FFC800"
                    stroke-width="2.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <div>
                  <b>{s.title}</b>
                  <i>{s.body}</i>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="colr">
        <p class="eyebrow work-eyebrow">{credibility.workEyebrow}</p>
        <ul class="work">
          {
            credibility.work.map((w) => (
              <li class="wk">
                <img
                  class="ghost"
                  src={`/logos/logo-${w.logo}-ghost.svg`}
                  alt=""
                  aria-hidden="true"
                  style={`width:${w.ghostWidth}`}
                  loading="lazy"
                  decoding="async"
                />
                <div class="mark">
                  <img
                    src={`/logos/logo-${w.logo}.svg`}
                    alt={w.logoAlt}
                    style={w.logoStyle}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <p class="res">{w.result}</p>
                <p class="qual">{w.qualifier}</p>
                <p class="vert">
                  <b>{w.company}</b>
                  <i>{w.vertical}</i>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    background: var(--paper-2);
    padding: 76px 0 68px;
  }
  /* stretch, not start: the two columns have to end level */
  .cg {
    display: grid;
    grid-template-columns: 404px 1fr;
    gap: 74px;
    align-items: stretch;
    /* 669 frame minus 76 + 68 of band padding. R4 cut a clause off the body
       copy, which took two lines out of the left column and collapsed the
       whole band by 55px. The frame is the approved one, so it is held here
       rather than left to whatever the longest column happens to be this
       week. Nothing has to move to absorb it: the heading block is anchored
       to the top and .sell is anchored to the bottom by margin-top:auto, so
       the cut lands in the gap between them, which is where it belongs. */
    min-height: 525px;
  }
  .col,
  .colr {
    display: flex;
    flex-direction: column;
  }
  .colr .work {
    flex: 1;
  }
  h2 {
    font-size: var(--fs-h2);
    line-height: 1;
    margin-top: 16px;
  }
  .body {
    margin-top: 22px;
    max-width: 382px;
  }

  /* --- selling points ----------------------------------------------------- */
  /* margin-top:auto pushes the list to the bottom of the column so its last
     rule meets the bottom of the client table. */
  .sell {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .sell li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 2px;
    border-bottom: 1px solid var(--rule);
    transition: padding-left var(--t-wipe) var(--ease);
  }
  .sell li:hover {
    padding-left: 8px;
  }
  .sell svg {
    flex: none;
    margin-top: 3px;
  }
  .sell b {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.25;
  }
  .sell i {
    display: block;
    font-style: normal;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-2);
    margin-top: 4px;
  }

  /* --- client table ------------------------------------------------------- */
  .work-eyebrow {
    margin-bottom: 18px;
  }
  .work {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .wk {
    position: relative;
    overflow: hidden;
    padding: 30px 18px 26px;
    display: flex;
    flex-direction: column;
    transition: background-color var(--t-card) var(--ease);
  }
  .wk + .wk {
    box-shadow: inset 1px 0 0 var(--rule);
  }
  .wk:hover {
    background: rgba(255, 200, 0, 0.1);
  }
  .wk .ghost {
    position: absolute;
    left: 50%;
    top: 52%;
    transform: translate(-50%, -50%);
    max-width: none;
    opacity: 0.34;
    pointer-events: none;
    transition:
      opacity 0.38s var(--ease),
      transform 0.5s var(--ease);
  }
  .wk:hover .ghost {
    opacity: 0.56;
    transform: translate(-50%, -50%) scale(1.05);
  }
  .wk > *:not(.ghost) {
    position: relative;
    z-index: 1;
  }
  .mark {
    height: 46px;
    display: flex;
    align-items: center;
  }
  .mark img {
    display: block;
  }
  /* the two auto margins are what centre the result between mark and company */
  .res {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 25px;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin-top: auto;
  }
  .qual {
    font-size: 12.5px;
    color: var(--ink-2);
    margin-top: 7px;
    line-height: 1.4;
  }
  .vert {
    margin-top: auto;
    padding-top: 18px;
    font-family: var(--font-display);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    line-height: 1.5;
  }
  .vert b {
    display: block;
    font-weight: 700;
    font-size: 11.5px;
    color: var(--ink);
  }
  .vert i {
    display: block;
    font-style: normal;
    font-weight: 500;
    font-size: 10px;
    color: var(--ink-3);
  }

  /* --- responsive --------------------------------------------------------- */
  @media (max-width: 1279px) {
    .cg {
      grid-template-columns: 340px 1fr;
      gap: 48px;
    }
    h2 {
      font-size: clamp(38px, 3.9vw, 50px);
    }
  }
  @media (max-width: 1023px) {
    .cg {
      grid-template-columns: minmax(0, 1fr);
      gap: 44px;
    }
    .body {
      max-width: 560px;
    }
    .sell {
      margin-top: 30px;
      max-width: 560px;
    }
    .work {
      grid-template-columns: repeat(2, 1fr);
    }
    .wk:nth-child(3) {
      box-shadow: none;
    }
    .wk:nth-child(3),
    .wk:nth-child(4) {
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 767px) {
    .band {
      padding: 56px 0;
    }
    h2 {
      font-size: 34px;
    }
    .work {
      grid-template-columns: minmax(0, 1fr);
    }
    .wk + .wk {
      box-shadow: none;
      border-top: 1px solid var(--rule);
    }
    .wk {
      padding: 20px 4px;
    }
    .res {
      margin-top: 16px;
    }
  }
</style>
