---
import { site } from "@/content/site";

/**
 * The wordmark break. 468px of full-bleed charcoal at 1440.
 *
 * The mouse-reactive slitscan runs behind everything at z-index 0, with a
 * vignette over it that darkens the edges so the slits dissolve instead of
 * being clipped. The lockup sits on top with the yellow sharpie swipe under it.
 *
 * This section is the only place on the page where the brand shouts. Everything
 * in it is decorative except the two lines of type.
 */
const { wordmark } = site;
---

<section class="brk" aria-labelledby="wordmark-tagline">
  <canvas data-slitscan="dark" aria-hidden="true"></canvas>
  <div class="vig" aria-hidden="true"></div>

  <p class="ticker">
    {
      wordmark.ticker.map((t, i) => (
        <>
          {i > 0 && <i aria-hidden="true" />}
          <span>{t}</span>
        </>
      ))
    }
  </p>

  <div class="lockwrap">
    <img class="lock" src="/brand/lockup-bone.svg" alt={wordmark.lockupAlt} width="860" height="172" loading="lazy" decoding="async" />
    <svg class="swipe" viewBox="0 0 700 22" preserveAspectRatio="none" aria-hidden="true">
      <path
        fill="#FFC800"
        fill-opacity=".9"
        d="M2,17 C120,12 300,19 470,13 C560,10 650,16 698,11 L697,3 C640,8 550,2 450,6 C300,12 130,4 4,9 Z"></path>
    </svg>
  </div>

  <div class="tagline">
    <p class="d" id="wordmark-tagline">{wordmark.tagline}</p>
    <p class="sub">{wordmark.sub}</p>
  </div>
</section>

<style>
  .brk {
    background: var(--charcoal);
    padding: 64px 0 70px;
    position: relative;
    overflow: hidden;
  }
  .brk canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    pointer-events: none;
  }
  .brk > *:not(canvas):not(.vig) {
    position: relative;
    z-index: 1;
  }
  .vig {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        var(--charcoal) 0%,
        rgba(28, 28, 26, 0) 14%,
        rgba(28, 28, 26, 0) 86%,
        var(--charcoal) 100%
      ),
      radial-gradient(
        126% 104% at 50% 50%,
        rgba(28, 28, 26, 0) 40%,
        rgba(28, 28, 26, 0.55) 82%,
        rgba(28, 28, 26, 0.86) 100%
      );
  }

  .ticker {
    /* it is a <p>, so it would otherwise inherit the 1.62 body leading and
       stand 1.8px taller than the band was drawn */
    line-height: normal;
    display: flex;
    gap: 30px;
    justify-content: center;
    align-items: center;
    opacity: 0.62;
    flex-wrap: wrap;
    padding-inline: 20px;
  }
  .ticker span {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--yellow);
    white-space: nowrap;
  }
  .ticker i {
    width: 4px;
    height: 4px;
    background: var(--yellow);
    opacity: 0.55;
    display: block;
    flex: none;
  }

  .lockwrap {
    position: relative;
    width: 860px;
    max-width: calc(100% - 40px);
    margin: 0 auto;
  }
  .lock {
    display: block;
    width: 100%;
    height: auto;
    margin: 40px auto 0;
  }
  .swipe {
    position: absolute;
    left: 152px;
    right: 2px;
    bottom: -16px;
    height: 27px;
  }

  .tagline {
    text-align: center;
    margin-top: 46px;
    padding-inline: 20px;
  }
  .tagline .d {
    color: var(--paper);
    font-size: 26px;
    letter-spacing: 0.02em;
  }
  .tagline .sub {
    color: #8e8a80;
    margin-top: 12px;
    font-size: 15px;
  }

  @media (max-width: 1023px) {
    .swipe {
      left: 17.7%;
    }
  }
  @media (max-width: 767px) {
    .brk {
      padding: 44px 0 52px;
    }
    .ticker {
      gap: 14px;
      row-gap: 10px;
    }
    .ticker span {
      font-size: 10px;
      letter-spacing: 0.2em;
    }
    .lock {
      margin-top: 30px;
    }
    .swipe {
      bottom: -8px;
      height: 14px;
    }
    .tagline {
      margin-top: 32px;
    }
    .tagline .d {
      font-size: 21px;
    }
    .tagline .sub {
      font-size: 13px;
    }
  }
</style>
