---
import { site } from "@/content/site";

/**
 * The wordmark break. 387px at 1440.
 *
 * Manila, charcoal lockup, the slitscan running behind it. The brand does not
 * shout here, it signs the page.
 *
 * R3 moved the ticker out of this section and onto the sticky rail at the
 * bottom of the viewport, where it can run as an actual line rather than four
 * labels blinking above a logo. What is left is the signature.
 *
 * The yellow swipe is aligned to the WORDMARK, not the whole lockup. Measured
 * off the lockup file itself: the wordmark path's bounding box runs x 1170.88
 * to 4317.25 in a 4496.7 viewBox, so 26.038% to 96.010%, the left edge of the
 * L to the right edge of the M. It is positioned by left + width, never by
 * left + right. See the note on .swipe.
 */
const { wordmark } = site;
---

<section class="brk" aria-label="What the work is for">
  <canvas data-slitscan data-intensity="1.2" aria-hidden="true"></canvas>
  <div class="vig" aria-hidden="true"></div>


  <div class="lockwrap">
    <img
      class="lock"
      src="/brand/lockup-charcoal.svg"
      alt={wordmark.lockupAlt}
      width="860"
      height="172"
      loading="lazy"
      decoding="async"
    />
    <svg class="swipe" viewBox="0 0 700 22" preserveAspectRatio="none" aria-hidden="true">
      <path
        fill="#FFC800"
        fill-opacity=".92"
        d="M2,17 C120,12 300,19 470,13 C560,10 650,16 698,11 L697,3 C640,8 550,2 450,6 C300,12 130,4 4,9 Z"></path>
    </svg>
  </div>
</section>

<style>
  .brk {
    background: var(--paper-2);
    /* The band is 387 in the reference and the height is load-bearing: the
       slitscan is drawn to fill it, and the wave's amplitude and slit length
       both scale off it. The ticker used to occupy the last ~70px. Taking the
       ticker out must not shrink the band, so the height stays and the lockup
       holds the position the reference gave it, 70px down from the top. */
    min-height: 387px;
    padding: 70px 0 76px;
    position: relative;
    overflow: hidden;
  }
  .brk canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    pointer-events: none;
    /* The slits are hard-edged rectangles of uniform length, so without this
       the band terminates in a straight line top and bottom and reads as a
       strip that got trimmed rather than a wave. The mask dissolves both
       edges into the paper. Costs nothing per frame. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 16%,
      #000 84%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 16%,
      #000 84%,
      transparent 100%
    );
  }
  .brk > *:not(canvas):not(.vig) {
    position: relative;
    z-index: 1;
  }
  .vig {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        var(--paper-2) 0%,
        rgba(234, 229, 218, 0) 15%,
        rgba(234, 229, 218, 0) 85%,
        var(--paper-2) 100%
      ),
      radial-gradient(
        130% 108% at 50% 50%,
        rgba(234, 229, 218, 0) 38%,
        rgba(234, 229, 218, 0.42) 82%,
        rgba(234, 229, 218, 0.74) 100%
      );
  }

  /* --- lockup -------------------------------------------------------------- */
  .lockwrap {
    position: relative;
    width: 860px;
    max-width: calc(100% - 40px);
    margin: 0 auto;
  }
  .lock {
    display: block;
    width: 100%;
    height: auto;
  }
  /* 26.04% and 3.99% are where the wordmark path starts and ends inside the
     lockup file. Percentages rather than pixels, so the line stays aligned at
     every width the lockup scales to. */
  .swipe {
    position: absolute;
    left: 26.04%;
    /* WIDTH, not `right`. An <svg> is a replaced element: with a viewBox and
       a set height it has an intrinsic width, so left + right + auto width is
       over-constrained and the browser throws `right` away. The swipe was
       being drawn 859px wide, its full 700:22 ratio against a 27px height,
       which is why it ran past the M no matter what `right` said.
       96.010% - 26.038% = 69.97%. */
    width: 69.97%;
    bottom: -16px;
    height: 27px;
  }

  @media (max-width: 767px) {
    .brk {
      padding: 44px 0 52px;
    }
    .lockwrap {
      margin-top: 0;
    }
    .swipe {
      bottom: -8px;
      height: 14px;
    }
  }
</style>
