---
import Base from "@/layouts/Base.astro";
import Button from "@/components/ui/Button.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/content/site";
import { bookHref } from "@/lib/links";

/**
 * "Send us a note".
 *
 * A separate page rather than a seventh section: the approved design is six
 * sections and a form does not belong in any of them. Same shell, same tokens,
 * no new visual language. Posts to the same /api/lead endpoint as the email
 * capture and works with scripting disabled.
 */
const c = site.contact;
const cap = site.breakdown.capture;
---

<Base
  title="Send us a note, Legroom"
  description="Tell us what's eating the week. One email back from a real person."
  canonicalPath="/contact"
>
  <main id="main" class="page">
    <div class="wrap">
      <a class="back" href="/">← {site.meta.name}</a>
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.headline}</h1>
      <p class="lead intro">{c.lead}</p>

      <form
        class="form"
        method="POST"
        action="/api/lead"
        data-lead-form
        data-source="contact"
        data-msg-sending={cap.sending}
        data-msg-success={cap.success}
        data-msg-error={cap.errorGeneric}
        data-msg-error-email={cap.errorEmail}
        data-msg-error-rate={cap.errorRate}
      >
        <input type="hidden" name="source" value="contact" />

        {/* Name is two fields now. They sit on one row at desktop and stack
            on a phone, so the form still reads as five short steps rather than
            seven. */}
        <div class="row">
          <div class="field">
            <label for="first-name">{c.firstNameLabel}</label>
            <input
              id="first-name"
              name="first_name"
              type="text"
              required
              autocomplete="given-name"
              enterkeyhint="next"
              placeholder={c.firstNamePlaceholder}
            />
          </div>

          <div class="field">
            <label for="last-name">
              {c.lastNameLabel} <span class="opt">{c.lastNameOptional}</span>
            </label>
            <input
              id="last-name"
              name="last_name"
              type="text"
              autocomplete="family-name"
              enterkeyhint="next"
              placeholder={c.lastNamePlaceholder}
            />
          </div>
        </div>

        <div class="field">
          <label for="email">{c.emailLabel}</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            enterkeyhint="next"
            placeholder={c.emailPlaceholder}
          />
        </div>

        <div class="field">
          <label for="website">
            {c.websiteLabel} <span class="opt">{c.websiteOptional}</span>
          </label>
          {/* type="text", not type="url". A url input rejects "acme.com" and
              demands a scheme, which is a validation error in front of someone
              who typed their own address correctly. The Worker normalises it. */}
          <input
            id="website"
            name="website"
            type="text"
            autocomplete="url"
            inputmode="url"
            enterkeyhint="next"
            spellcheck="false"
            placeholder={c.websitePlaceholder}
          />
        </div>

        <div class="field">
          <label for="message">
            {c.messageLabel} <span class="opt">{c.messageOptional}</span>
          </label>
          <textarea id="message" name="message" rows="5" placeholder={c.messagePlaceholder}
          ></textarea>
        </div>

        <div class="hp" aria-hidden="true">
          <label for="company">Company (leave blank)</label>
          <input id="company" type="text" name="company" tabindex="-1" autocomplete="off" />
        </div>
        <div class="cf-turnstile" data-turnstile></div>

        <Button variant="yellow" type="submit" arrow class="submit">{c.submit}</Button>
      </form>

      <p class="status" data-lead-status role="status" aria-live="polite"></p>

      <p class="small alt">
        Prefer to book straight in? <a href={bookHref} data-cta="contact-inline">Take the 15 minutes.</a>
      </p>
    </div>
  </main>
  <Footer />
</Base>

<script>
  import { initForms } from "@/scripts/form";
  import { initAnalytics, initGa4 } from "@/scripts/analytics";
  import { initPointerTilt } from "@/scripts/pointer-tilt";
  initForms(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "");
  initGa4(import.meta.env.PUBLIC_GA4_ID ?? "");
  initAnalytics();
  initPointerTilt();
</script>

<style>
  .page {
    padding: 56px 0 40px;
    /* svh, not vh. vh measures the LARGEST viewport, the one you only get
       once the address bar has collapsed, so on first paint a vh block is
       taller than the screen and its bottom is cut off. svh is the smallest
       viewport and always fits. */
    min-height: 70svh;
  }
  .back {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 18px;
  }
  .back:hover {
    color: var(--ink);
  }
  h1 {
    font-size: clamp(36px, 4.4vw, 56px);
    margin-top: 16px;
  }
  .intro {
    margin-top: 20px;
    max-width: 520px;
  }
  .form {
    margin-top: 40px;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  /* Two fields on one line at desktop, stacked on a phone. 1fr 1fr rather
     than auto: a first name and a last name are the same weight and should
     look it. */
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  /* "optional" has to be visible enough to be read BEFORE someone starts
     typing, and quiet enough not to compete with the label. Anything that
     reads as a second label makes the form look longer than it is. */
  .opt {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-3);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .field label {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .field input,
  .field textarea {
    border: 0;
    background: var(--paper);
    box-shadow: inset 0 0 0 2px var(--ink);
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--ink);
    padding: 14px 16px;
    min-height: 52px;
    width: 100%;
  }
  .field textarea {
    resize: vertical;
    line-height: 1.55;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--ink-3);
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form :global(.submit) {
    align-self: flex-start;
  }
  .status {
    margin-top: 16px;
    font-size: 14px;
    color: var(--ink);
    max-width: 560px;
  }
  .status:empty {
    display: none;
  }
  .status[data-state="error"] {
    color: #9a3412;
  }
  .alt {
    margin-top: 28px;
    color: var(--ink-2);
  }
  /* an inline link inside a sentence needs more than colour to be findable */
  .alt a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }
  .alt a:hover {
    text-decoration-thickness: 2.5px;
  }
  @media (max-width: 767px) {
    .form :global(.submit) {
      align-self: stretch;
      justify-content: center;
    }
  }
</style>
