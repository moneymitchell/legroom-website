---
import Base from "@/layouts/Base.astro";
import Hero from "@/components/Hero.astro";
import Breakdown from "@/components/Breakdown.astro";
import Credibility from "@/components/Credibility.astro";
import PromiseSection from "@/components/Promise.astro";
import WordmarkBreak from "@/components/WordmarkBreak.astro";
import Founders from "@/components/Founders.astro";
import Footer from "@/components/Footer.astro";
import StickyRail from "@/components/StickyRail.astro";
import { bookHref, contactHref } from "@/lib/links";

---

<Base>
  <Hero bookHref={bookHref} contactHref={contactHref} />
  <main id="main">
    <Breakdown />
    <Credibility />
    <PromiseSection />
    <WordmarkBreak />
    <Founders bookHref={bookHref} contactHref={contactHref} />
  </main>
  <Footer />
  <StickyRail />
</Base>

<script>
  // No inline script: this module is bundled, and PUBLIC_* values are replaced
  // at build time, so the config travels inside the bundle rather than in a
  // separate <script> tag the CSP would have to allow.
  import { initSlitscans } from "@/scripts/slitscan";
  import { initMeasureRules } from "@/scripts/measure-rule";
  import { initForms } from "@/scripts/form";
  import { initCal, tagCalLinks } from "@/scripts/cal";
  import { initAnalytics, initGa4 } from "@/scripts/analytics";
  import { initPointerTilt } from "@/scripts/pointer-tilt";
  import { calSlug } from "@/lib/links";

  // Wiring first: it is cheap, and the CTAs and forms have to be live the
  // moment the page is.
  initForms(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "");
  tagCalLinks(calSlug);
  initCal(calSlug);
  initGa4(import.meta.env.PUBLIC_GA4_ID ?? "");
  initAnalytics();
  initPointerTilt();

  // The canvas loops, the wordmark slitscan and the hero measure, are the only
  // continuous work on the page. Starting them once the main thread is idle
  // keeps them out of the interaction window: it costs a few hundred
  // milliseconds of an eight-second wave nobody is waiting for, and it is the
  // difference between 190ms and near-zero total blocking time.
  /**
   * The wordmark band is taken OUT OF THE DOM below the tablet breakpoint,
   * not hidden with display: none.
   *
   * It is a full-bleed band built around an 860px lockup and a pointer-driven
   * canvas. A phone has neither the width nor a pointer: the lockup clips at
   * the left edge, the wave is a frozen frame, and it costs about 390px of
   * scrolling to show a logo the visitor has already seen in the nav. Removing
   * the node means it is never laid out, never painted, never composited, and
   * its canvas can never start a loop.
   *
   * Honest about what this does not do: the site is statically generated, so
   * one HTML file serves every device and the markup is still DOWNLOADED. That
   * is roughly 400 bytes. The costs that actually matter on a phone, layout,
   * paint and a rAF loop, all go away.
   *
   * 768 matches the breakpoint WordmarkBreak.astro itself uses. matchMedia
   * rather than a resize listener: this runs once, and a phone does not change
   * class mid-session.
   */
  if (window.matchMedia?.("(max-width: 767px)").matches) {
    document.querySelector("section.brk")?.remove();
  }

  const start = () => {
    initSlitscans();
    initMeasureRules();
  };
  if ("requestIdleCallback" in window) {
    requestIdleCallback(start, { timeout: 1500 });
  } else {
    setTimeout(start, 200);
  }
</script>
