---
import "../styles/global.css";
import { site } from "@/content/site";
import Intro from "@/components/Intro.astro";

/**
 * The document shell: head, metadata, structured data, skip link.
 *
 * Fonts are self-hosted, subset, and preloaded for the two faces used above the
 * fold (Oswald 700 for the headline, DM Sans 400 for the lead). font-display:block
 * means the page never paints fallback type and then reflows, so there is no FOUT
 * to cause layout shift. The faces are 8-12KB each and served from our own origin,
 * so the block period is short enough not to be felt.
 */
interface Props {
  title?: string;
  description?: string;
  /** /thanks should not be indexed. */
  noindex?: boolean;
  canonicalPath?: string;
  /** Mounts the first-visit intro gate and overlay. Homepage only. */
  intro?: boolean;
}
const {
  title = site.meta.title,
  description = site.meta.description,
  noindex = false,
  canonicalPath = "/",
  intro = false,
} = Astro.props;

const canonical = new URL(canonicalPath, site.meta.url).href;

/**
 * THE INTRO GATE. Blocking, inline, and as early in <head> as it can be,
 * because everything it decides has to be true before the first paint.
 *
 * Checking after paint gives a flash of homepage and then an overlay slamming
 * over the top of it, which is worse than having no intro at all.
 *
 * It is inline rather than a file because a <script src> in <head> is a
 * blocking round trip charged to EVERY visitor, including the returning ones
 * this whole design exists to charge nothing. Inline costs them these bytes
 * and not one request.
 *
 * IT IS A STRING RENDERED WITH set:html, NOT SCRIPT CHILDREN. Inside the
 * `{intro && ...}` expression below, Astro parses children as JSX, so a
 * template literal written there lands in the output verbatim: braces,
 * backticks and all. The result is `{`...`}`, which is a block containing a
 * string expression. Perfectly valid JavaScript that does nothing, throws
 * nothing, and logs nothing. Cost an hour. set:html emits the exact bytes.
 *
 * Being inline, it needs a CSP hash in public/_headers, and set:html makes
 * those bytes deterministic. scripts/check-intro-csp.mjs verifies the hash
 * against the built HTML in the predeploy guard. Edit this string and the
 * guard fails until it is regenerated. It fails safe either way: a blocked
 * gate sets no attribute, so the homepage renders as normal.
 *
 * Order is deliberate. Reduced motion is checked BEFORE the flag is written,
 * so someone who has it on today and turns it off next month still gets a
 * first visit rather than having silently spent it.
 *
 * THE PRELOAD IS LOW PRIORITY, AND THAT IS THE WHOLE POINT OF IT.
 *
 * It was fetchpriority="high" first, on the reasoning that the plate is the
 * first thing anyone sees. Measured, that cost 452ms of mobile Largest
 * Contentful Paint, and not in the way anyone expected: the LCP element is not
 * the plate at all, it is the <h1>. Both display faces are font-display:block,
 * so the headline cannot paint until Oswald 700 arrives, and a high priority
 * 53KB image sharing a throttled connection with two preloaded fonts makes
 * them all arrive later. The intro was taking bandwidth from the sentence the
 * site exists to say.
 *
 * Low priority puts the fonts back in front. The plate loses that race by
 * design and has slack to lose it in: the overlay paints the illustration's
 * own sky blue immediately, and intro.ts waits up to 600ms for the plate to
 * decode before starting the timeline. Nobody sees a gap; they see the sky.
 */
const introGate = `(function(){
  try {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (localStorage.getItem("lg.intro.seen")) return;
    localStorage.setItem("lg.intro.seen", "1");
  } catch (e) { return; }
  var portrait = innerWidth < 768;
  var dense = (devicePixelRatio || 1) > 1.5;
  var src = "/intro/sky-" + (portrait ? "mobile" : "desktop") + (dense ? "-2x" : "") + ".webp";
  var l = document.createElement("link");
  l.rel = "preload";
  l.as = "image";
  l.href = src;
  l.setAttribute("fetchpriority", "low");
  document.head.appendChild(l);
  var d = document.documentElement;
  d.dataset.introSrc = src;
  d.dataset.intro = "run";
})();`;
const ogImage = new URL(site.meta.ogImage, site.meta.url).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.meta.url}/#organization`,
      name: site.meta.name,
      legalName: site.meta.legalName,
      url: site.meta.url,
      email: site.meta.email,
      foundingDate: site.meta.foundingYear,
      logo: { "@type": "ImageObject", url: `${site.meta.url}/brand/lockup-charcoal.svg` },
      image: ogImage,
      description: site.meta.description,
      address: {
        "@type": "PostalAddress",
        addressRegion: site.meta.region,
        addressCountry: "US",
      },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${site.meta.url}/#business`,
      name: site.meta.legalName,
      url: site.meta.url,
      email: site.meta.email,
      image: ogImage,
      description: site.meta.description,
      parentOrganization: { "@id": `${site.meta.url}/#organization` },
      address: {
        "@type": "PostalAddress",
        addressRegion: site.meta.region,
        addressCountry: "US",
      },
      areaServed: { "@type": "State", name: "Washington" },
    },
    {
      "@type": "WebSite",
      "@id": `${site.meta.url}/#website`,
      url: site.meta.url,
      name: site.meta.name,
      description: site.meta.description,
      publisher: { "@id": `${site.meta.url}/#organization` },
      inLanguage: "en-US",
    },
    {
      "@type": "Service",
      "@id": `${site.meta.url}/#breakdown`,
      name: "The free 15-minute breakdown call",
      serviceType: "Business process and automation assessment",
      provider: { "@id": `${site.meta.url}/#organization` },
      areaServed: { "@type": "State", name: "Washington" },
      description:
        "A free 15-minute call on how work moves through your business, naming the most expensive thing the team does by hand and what it is costing.",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
        availability: "https://schema.org/LimitedAvailability",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* interactive-widget=resizes-content: without it the on-screen keyboard
        overlays the page, so on a short phone the submit button ends up
        underneath it and the field you are typing into can be covered by it.
        With it, the layout viewport shrinks and the form stays reachable. */}
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />
    {intro && <script is:inline set:html={introGate} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="preload" href="/fonts/Oswald-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/DMSans-400.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F4F1EA" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.meta.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.meta.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  </head>
  <body>
    {/* First in the body, so it is parsed and covering before any homepage
        content paints underneath it. Last would give exactly the flash the
        gate above exists to prevent. It holds no focusable elements, so its
        position here does not touch the tab order. */}
    {intro && <Intro />}
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
