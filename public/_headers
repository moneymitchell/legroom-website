# Cloudflare Workers static assets reads this file.
#
# static.cloudflareinsights.com is in script-src because Cloudflare injects its
# Real User Monitoring beacon at the edge on this plan and there is no toggle to
# stop it: the old Speed > Content Optimization > Browser Insights switch is
# gone, and what replaced it, Speed > Real user monitoring, is a dashboard
# rather than a setting. Blocking it achieved nothing except a console error on
# every page load. Allowed deliberately, and it earns its place: it is the only
# source of Core Web Vitals from real visitors on real networks, which is
# something neither Lighthouse nor GA4 can give.
# The 'sha256-...' in script-src is the first-visit intro gate, the one inline
# script on the site. It is inline because it must decide before the first
# paint, and a <script src> in <head> is a blocking round trip charged to every
# visitor including the returning ones the gate exists to charge nothing.
#
# A hash pins exact bytes. Edit the gate in src/layouts/Base.astro without
# regenerating, and the browser blocks it silently: no build error, no test
# failure, the intro just stops existing. scripts/check-intro-csp.mjs runs in
# the predeploy guard to make that loud. Regenerate with:
#   npm run build && node scripts/check-intro-csp.mjs --write
#
# Adding a hash does NOT disable 'self' or the Cal and Turnstile origins. Only
# 'strict-dynamic' would do that, and this policy does not use it.
#
# Note: these apply to ASSET responses only. Responses generated by the Worker
# (that is, /api/lead) set their own headers in worker/index.ts.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' https://challenges.cloudflare.com https://app.cal.com https://cal.com https://www.googletagmanager.com https://static.cloudflareinsights.com 'sha256-YFM4W8UHYL1M/DCnw6Rf29P3BPjlFh0ZmXXUkqvuXiE='; connect-src 'self' https://challenges.cloudflare.com https://app.cal.com https://cal.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://static.cloudflareinsights.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com https://app.cal.com https://cal.com; upgrade-insecure-requests

# Hashed build output is immutable by construction.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and brand art change only with a deploy, and are content-stable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/brand/*
  Cache-Control: public, max-age=604800
/logos/*
  Cache-Control: public, max-age=604800
/photos/*
  Cache-Control: public, max-age=604800
# The intro plates are content-stable and fetched once per visitor, ever.
/intro/*
  Cache-Control: public, max-age=604800

# HTML must never be cached hard: an edit has to be live on the next request.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/contact
  Cache-Control: public, max-age=0, must-revalidate
/thanks
  Cache-Control: public, max-age=0, must-revalidate
