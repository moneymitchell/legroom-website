{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*.ts", "src/**/*.astro", "scripts/**/*.mjs"],
  "exclude": ["dist", "node_modules", "worker"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    // TypeScript 7 removed baseUrl; paths are relative to this file.
    "paths": { "@/*": ["./src/*"] }
  }
}
