    "deploy": "astro build && wrangler deploy",
    "cf:dev": "astro build && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply legroom-leads --remote",
    "test:pixels": "node scripts/compare-reference.mjs",
    "test:design": "node scripts/compare-design.mjs",
    "lh:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "lh:report": "node scripts/lh-summary.mjs",
    "check:csp": "node scripts/check-csp.mjs"
  },
