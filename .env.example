# ---------------------------------------------------------------------------
# Build-time, PUBLIC values only. These are compiled into the HTML, so they are
# visible to anyone who views source. That is fine for both of them.
#
# EVERY SECRET lives in Wrangler, never in this repo:
#   npx wrangler secret put TURNSTILE_SECRET_KEY
#   npx wrangler secret put RESEND_API_KEY
# See LAUNCH.md section 2.
# ---------------------------------------------------------------------------

# Cal.com booking link. Slug or full URL. Empty = every "Book" CTA falls back
# to /contact, which still works. Fill this in and the buttons switch over.
PUBLIC_CAL_LINK=

# Cloudflare Turnstile SITE key (starts 0x4AAA...). Empty = the widget is never
# loaded and the Worker applies its no-token spam controls instead.
PUBLIC_TURNSTILE_SITE_KEY=
